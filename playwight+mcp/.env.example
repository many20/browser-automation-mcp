# Copy this file to .env and adjust values if needed.

PLAYWRIGHT_MCP_VERSION=0.0.79
PLAYWRIGHT_MCP_PORT=8931

# Bearer token for MCP and CDP endpoints.
# If left empty, a random token is generated on container startup.
MCP_AUTH_TOKEN=

# noVNC / VNC settings
NOVNC_PORT=6080
VNC_PORT=5901
VNC_PASSWORD=vscode
VNC_RESOLUTION=1920x1080x16

SHM_SIZE=2gb
