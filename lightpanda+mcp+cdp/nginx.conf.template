events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Lightpanda native MCP HTTP/SSE endpoint (externally exposed with Bearer token)
    server {
        listen 0.0.0.0:8931;
        server_name _;

        location / {
            if ($http_authorization != "Bearer $MCP_AUTH_TOKEN") {
                return 401 "Unauthorized\n";
            }

            proxy_pass http://ai-mcp-lightpanda:9223;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # SSE support
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;

            # WebSocket support (for future transports)
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }
    }

    # Lightpanda CDP/WebSocket endpoint (externally exposed with Bearer token or ?token=)
    server {
        listen 0.0.0.0:8932;
        server_name _;

        location / {
            set $auth_ok "no";
            if ($http_authorization = "Bearer $MCP_AUTH_TOKEN") {
                set $auth_ok "yes";
            }
            if ($arg_token = $MCP_AUTH_TOKEN) {
                set $auth_ok "yes";
            }
            if ($auth_ok != "yes") {
                return 401 "Unauthorized\n";
            }

            proxy_pass http://ai-cdp-lightpanda:9222;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;

            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }
    }
}
